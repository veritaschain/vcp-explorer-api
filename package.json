{
  "name": "vcp-explorer-api",
  "version": "1.1.0",
  "description": "VCP Explorer API v1.1 - Production-ready with Merkle Proof verification, VCP module structure, and advanced search",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "node --test test/*.test.cjs"
  },
  "keywords": [
    "veritaschain",
    "vcp",
    "blockchain",
    "audit",
    "trading",
    "algorithmic-trading",
    "mifid2",
    "compliance"
  ],
  "author": "VeritasChain Standards Organization (VSO)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/veritaschain/vcp-explorer-api"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11"
  }
}
